# CabBook Environment Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git!

## Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=cabbook
DATABASE_USER=postgres
DATABASE_PASSWORD=your-secure-password-here

# Full connection string (alternative to individual vars)
ConnectionStrings__DefaultConnection=Host=localhost;Database=cabbook;Username=postgres;Password=your-secure-password-here;Port=5432

## JWT Configuration
Jwt__Secret=your-super-secret-jwt-key-change-this-in-production
Jwt__Issuer=cabbook
Jwt__ExpirationMinutes=1440

## Application Settings
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

## Logging
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft=Warning

## CORS Configuration
CORS__AllowedOrigins=http://localhost:3000,http://localhost:8080,https://yourdomain.com

## Email Configuration (for notifications - future)
Email__Provider=smtp
Email__SmtpHost=smtp.gmail.com
Email__SmtpPort=587
Email__SmtpUsername=your-email@gmail.com
Email__SmtpPassword=your-app-password
Email__FromAddress=noreply@cabbook.com
Email__FromName=CabBook

## SMS Configuration (for notifications - future)
SMS__Provider=twilio
SMS__AccountSid=your-twilio-account-sid
SMS__AuthToken=your-twilio-auth-token
SMS__FromNumber=+1234567890

## Timezone Configuration
DefaultTimezone=UTC
SupportedTimezones=UTC,America/New_York,Europe/London,Asia/Kolkata

## OTP Configuration
OTP__ExpiryMinutes=5
OTP__MaxAttempts=3
OTP__MaxRequestsPerHour=5

## Feature Flags
Features__EnableNotifications=false
Features__EnableApprovals=false
Features__EnableServiceCalendar=true

## AWS Configuration (if using AWS)
AWS__Region=us-east-1
AWS__AccessKeyId=your-access-key
AWS__SecretAccessKey=your-secret-key
AWS__S3Bucket=cabbook-exports

## Azure Configuration (if using Azure)
Azure__StorageAccount=your-storage-account
Azure__StorageKey=your-storage-key
Azure__Container=exports

## Render Configuration (if deployed on Render)
# These are automatically set by Render
RENDER=true
RENDER_EXTERNAL_URL=https://cabbook-xxxxx.onrender.com

## Google OAuth (future authentication option)
Google__ClientId=your-google-client-id
Google__ClientSecret=your-google-client-secret

## GitHub OAuth (future authentication option)
GitHub__ClientId=your-github-client-id
GitHub__ClientSecret=your-github-client-secret

## Redis Configuration (if caching enabled)
Redis__Host=localhost
Redis__Port=6379
Redis__Database=0
Redis__Password=

## Monitoring & Analytics
Sentry__DSN=
NewRelic__LicenseKey=
DataDog__ApiKey=

## Rate Limiting
RateLimit__RequestsPerMinute=60
RateLimit__RequestsPerHour=1000

## Security
Security__AllowedHosts=localhost,yourdomain.com
Security__RequireHttps=true
Security__SslRedirect=true

## Database Backup (automated)
Backup__Enabled=true
Backup__Schedule=0 2 * * *
Backup__RetentionDays=30

## Session Configuration
Session__Timeout=30
Session__CookieName=cabbook_session
Session__SecureCookie=true

## CORS Policy
CORS__AllowedMethods=GET,POST,PUT,DELETE,OPTIONS
CORS__AllowedHeaders=*
CORS__AllowCredentials=true

## File Upload
Upload__MaxFileSize=10485760
Upload__AllowedExtensions=.csv,.xlsx,.pdf
Upload__StoragePath=/uploads

## Docker-specific (ignored outside Docker)
DB_HOST=db
DB_PORT=5432
