{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=cabbook;Username=postgres;Password=postgres;Port=5432"
  },
  "Jwt": {
    "Secret": "your-super-secret-key-change-in-production",
    "Issuer": "cabbook",
    "ExpirationMinutes": 1440
  },
  "Email": {
    "Enabled": false,
    "Provider": "Console",
    "FromEmail": "noreply@cabbook.com",
    "FromName": "CabBook",
    "Smtp": {
      "Host": "smtp.sendgrid.net",
      "Port": 587,
      "Username": "apikey",
      "Password": "your-sendgrid-api-key",
      "EnableSsl": true
    }
  },
  "App": {
    "Name": "CabBook",
    "Environment": "Development",
    "Url": "http://localhost:8080"
  }
}
